DirectoryIndex index.html index.php

RewriteEngine On

# One canonical host: https://www.cognabright.com. The bare domain and the
# alias domains parked on this hosting account (same server and certificate)
# redirect permanently so search engines index a single official site.
# /.well-known/ is excluded so certificate validation keeps working.
# cognabright.com.br intentionally serves the same site (see README).
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTP_HOST} ^(?:www\.)?cognabright\.(?:online|net|co|com\.au|au)\.?$ [NC,OR]
RewriteCond %{HTTP_HOST} ^cognabright\.com\.?$ [NC]
RewriteRule ^ https://www.cognabright.com%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# Keep these legacy redirects aligned with vercel.json.
RewriteRule ^(?:pilots|for-families)(?:\.html|/)?$ /families [R=301,L,NE]
RewriteRule ^(?:professionals|for-professionals|for-therapists|for-clinics)(?:\.html|/)?$ /organisations [R=301,L,NE]
RewriteRule ^features(?:\.html|/)?$ /platform [R=301,L,NE]
RewriteRule ^(?:case-studies|outcomes)/?$ /evidence [R=301,L,NE]
RewriteRule ^contact-sales/?$ /contact [R=301,L,NE]
RewriteRule ^(?:account-deletion|delete-my-account)/?$ /delete-account [R=301,L,NE]
# Research is hidden for now (no active research programme). Temporary redirect.
RewriteRule ^research(?:\.html|/)?$ / [R=302,L,NE]
RewriteRule ^signup/?$ https://app.cognabright.com/sign-in [R=302,L,NE]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "DENY"
</IfModule>

# BEGIN cPanel-generated php ini directives, do not edit
<IfModule php8_module>
   php_value error_log "/home/cognabright/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/cognabright/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit
